{
  "private": true,
  "name": "monitoreo-iot",
  "version": "1.0.0",
  "description": "Sistema de Monitoreo Ambiental IoT con Detecci\u00f3n de Anomal\u00edas y Alertas Distribuidas",
  "author": "Miguel Angel Becerra Zarate",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "humo": "node scripts/humo.mjs",
    "sistema": "node scripts/sistema.mjs",
    "lint": "eslint . --ext .ts",
    "entrenar": "node --disable-warning=ExperimentalWarning packages/trainer/dist/train.js",
    "evaluar": "node --disable-warning=ExperimentalWarning packages/trainer/dist/evaluate.js",
    "resiliencia": "node scripts/resiliencia.mjs",
    "tablero": "node --disable-warning=ExperimentalWarning packages/dashboard/dist/index.js",
    "detener": "node scripts/detener.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vite": "^7.0.0"
  }
}
